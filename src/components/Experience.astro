---
import { getLangFromUrl, t } from '../i18n/ui';

const copy = t(getLangFromUrl(Astro.url)).experience;
const rows = copy.rows;
---

<section id="experience" class="exp" aria-labelledby="exp-title">
  <div class="head">
    <div class="eyebrow" data-reveal>{copy.eyebrow}</div>
    <h2 id="exp-title" data-headline data-speed="1.14"><span class="hl"
        >{copy.titleLead}<br /><span class="mark"><span class="mark-text">{copy.titleMark}</span><span class="mark-bg"
          ></span></span></span
      ></h2>
  </div>
  <div class="rows" data-reveal-stagger>
    {
      rows.map((r) => (
        <div class="row" data-reveal-item>
          <div class="when">{r.when}</div>
          <div class="body">
            <div class="role">{r.role}</div>
            <p>{r.desc}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .exp {
    padding: 0 clamp(24px, 7vw, 120px) 64px;
    max-width: 1440px;
    margin: 0 auto;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 40px 0 16px;
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-weight: 500;
  }
  h2 {
    margin: 0;
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .rows {
    display: flex;
    flex-direction: column;
  }
  .row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 32px;
    padding: 28px 0;
    border-top: 1px solid transparent;
    border-image: var(--flow-rule-x) 1;
    animation: var(--flow-slide);
  }
  /* Each row starts its sweep later than the one above, so the highlight reads
     as a single pulse running down the list instead of five in lockstep. The
     divisors are one full cycle split five ways. */
  .row:nth-child(2) {
    animation-delay: calc(var(--flow-dur) / -5);
  }
  .row:nth-child(3) {
    animation-delay: calc(var(--flow-dur) / -2.5);
  }
  .row:nth-child(4) {
    animation-delay: calc(var(--flow-dur) / -1.67);
  }
  .row:nth-child(5) {
    animation-delay: calc(var(--flow-dur) / -1.25);
  }
  .row:last-child {
    border-bottom: 1px solid transparent;
  }
  .when {
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
    padding-top: 6px;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .role {
    font-size: clamp(20px, 2.4vw, 24px);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .body p {
    margin: 0;
    font-size: 15px;
    color: var(--color-ink-muted);
    line-height: 1.6;
    max-width: 520px;
  }
  @media (max-width: 620px) {
    .row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
