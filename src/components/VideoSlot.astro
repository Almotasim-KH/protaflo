---
// Video twin of ImageSlot: same flow-ring tile, but the artefact is a screen
// recording served straight from /public (astro:assets only handles images).
// Intrinsic width/height come from frontmatter so the tile reserves its ratio
// before the file loads — no layout shift on the detail page.
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  src: string;
  width: number;
  height: number;
  /**
   * What the recording shows, in a sentence. Doubles as the accessible name and
   * as the text a visitor reads when the clip does not play. Required in
   * practice: without it the element's fallback is the file's own URL, which is
   * what a screen reader then announces.
   */
  label: string;
  radius?: number;
  /**
   * Whether this tile is in the first screenful. Above the fold the browser may
   * fetch metadata straight away; below it nothing is fetched until the tile is
   * near the viewport, so three walkthroughs no longer open the page in
   * parallel on a phone.
   */
  eager?: boolean;
  // Tile ratio. Defaults to the file's own; the work grid overrides it to keep
  // every card the same size, and pairs it with fit="cover" so the frame fills.
  aspect?: string;
  fit?: 'contain' | 'cover';
}

const {
  src,
  width,
  height,
  label,
  radius = 20,
  eager = false,
  aspect = `${width} / ${height}`,
  fit = 'contain',
  class: className = '',
  ...rest
} = Astro.props;
---

<div
  class:list={['imgslot vidslot', className]}
  style={`--r:${radius}px;--aspect:${aspect};--fit:${fit}`}
  {...rest}
>
  {
    /* No controls — this reads as a moving screenshot, not a player: muted, looping,
      and inert to clicks (pointer-events off below). autoplay is dropped under
      reduced-motion by the inline guard. */
  }
  {
    /* The fallback between the tags is not decoration. A <video> with nothing
      inside it falls back to its own src, so a failed load printed
      "/videos/….mp4" in the middle of the card and a screen reader read the path
      out. The sentence below is what the recording shows, which is the thing a
      reader actually needed in both cases. */
  }
  <video
    src={src}
    width={width}
    height={height}
    autoplay
    muted
    loop
    playsinline
    preload={eager ? 'metadata' : 'none'}
    aria-label={label}><p class="vidslot-fallback">{label}</p></video
  >
</div>

<script>
  // Reduced motion: stop the loop and hand the viewer a paused first frame.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('.vidslot video').forEach((v) => {
      v.autoplay = false;
      v.loop = false;
      v.pause();
    });
  }
</script>

<style>
  /* Mirrors .imgslot in ImageSlot.astro — scoped styles don't cross components,
     so the tile chrome is repeated here rather than shared through global.css. */
  .vidslot {
    position: relative;
    border-radius: var(--r);
    overflow: hidden;
    aspect-ratio: var(--aspect);
    border: 1px solid transparent;
    background:
      linear-gradient(var(--fill, transparent), var(--fill, transparent)) padding-box,
      var(--flow-ring) border-box;
    animation: var(--flow-spin);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Only ever seen when the browser will not play the file at all, so it is set
     as a caption inside the tile rather than as raw text on the ground. */
  .vidslot-fallback {
    margin: 0;
    padding: 16px 20px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-ink-muted);
    text-align: center;
  }
  /* Inert: no controls, no click-to-pause, no context menu handle. */
  .vidslot video {
    pointer-events: none;
    width: 100%;
    height: 100%;
    object-fit: var(--fit, contain);
    display: block;
  }
</style>
