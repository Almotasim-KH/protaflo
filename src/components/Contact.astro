---
// The close: a colophon, not a call-to-action island.
//
// The page has spent its whole length being a printed feature, so it ends the
// way one ends. The ask is a line of running text at reading size, the two other
// places to find me are footnotes beside it, and under a rule the page says what
// it is set in and where it was written. The last screen holds content rather
// than fading out.
import { getLangFromUrl, t } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const all = t(lang);
const copy = all.contact;
const col = all.colophon;
const foot = all.footer;
const email = 'portfolio.info@almotasim-kh.com';
const linkedin = 'https://www.linkedin.com/in/almotasim-khairullah-73ab52166/';
const github = 'https://github.com/Almotasim-KH';
---

<section id="contact" class="contact" data-ground="light" aria-labelledby="contact-title">
  <div class="contact-inner">
    <h2 id="contact-title" data-headline>
      <span class="hl"
        >{copy.titleLead}<br />{copy.titleSecond}<span class="mark"><span class="mark-text"
            >{copy.titleMark}</span
          ><span class="mark-bg"></span></span></span
      >
    </h2>

    <p class="ask" data-reveal>
      <a href={`mailto:${email}`}>{email}</a>
    </p>

    <p class="aside" data-reveal>
      <a href={linkedin} rel="noopener">{copy.linkedin}</a>
      <a href={github} rel="noopener">{copy.github}</a>
      <span class="note">{copy.note}</span>
    </p>

    <div class="colophon" data-reveal>
      <span>{col.set}</span>
      <span>{col.built}</span>
      <span>{col.place}</span>
      <span class="rights">{foot.rights}</span>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: clamp(60px, 10vw, 130px) clamp(24px, 7vw, 120px) clamp(70px, 10vw, 120px);
  }
  .contact-inner {
    max-width: 1240px;
    margin: 0 auto;
  }
  h2 {
    margin: 0;
    font-size: clamp(32px, 5.4vw, 72px);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.05;
    max-width: 14ch;
    text-wrap: balance;
  }
  /* The ask, set as running text. It is the largest link on the page and it is
     still a link, which is the whole difference between this ending and a
     button island. */
  .ask {
    margin: clamp(26px, 4vw, 44px) 0 0;
    font-size: clamp(18px, 2.6vw, 30px);
    font-weight: 500;
    letter-spacing: -0.01em;
    word-break: break-word;
  }
  .ask a {
    text-decoration: none;
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-repeat: no-repeat;
    background-position: 0 92%;
    background-size: 100% 26%;
    transition: background-size 0.28s var(--ease-out);
    padding: 0 2px;
  }
  .ask a:hover,
  .ask a:focus-visible {
    background-size: 100% 100%;
  }
  [dir='rtl'] .ask a {
    background-position: 100% 92%;
  }
  .aside {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 26px;
    margin: 18px 0 0;
    font-size: 14px;
  }
  .aside a {
    min-height: 30px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid var(--color-hairline);
    transition: border-color 0.16s var(--ease-out);
  }
  .aside a:hover,
  .aside a:focus-visible {
    border-bottom-color: currentColor;
  }
  .note {
    color: var(--color-ink-muted);
  }
  /* Pushed to the end of the colophon line, so the last thing set on the page is
     the smallest thing on it. */
  .rights {
    margin-inline-start: auto;
  }
  @media (pointer: coarse) {
    .aside a {
      min-height: 44px;
    }
  }
</style>
