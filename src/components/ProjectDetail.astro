---
// Shared by /work/<slug>/ and /ar/work/<slug>/ — the two route files differ only
// in which paths they emit, so the page itself lives here.
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ImageSlot from './ImageSlot.astro';
import VideoSlot from './VideoSlot.astro';
import Footer from './Footer.astro';
import { getLangFromUrl, localizePath, t } from '../i18n/ui';
import { localizeProject } from '../i18n/project';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const data = localizeProject(project.data, lang);
const copy = t(lang).detail;

// Analysis work is one artefact — a dashboard or a report — so it shows a single
// full-width image: its own shot if given, else the cover used on the work card.
// Build work pads to 6 slots so the layout still matches the design until real
// shots land; once supplied, show exactly those — no trailing placeholders, and
// each keeps its native proportions.
const gallery = data.gallery ?? [];
// A project with a screen recording shows that instead of stills.
const video = data.video;
const single = Boolean(video) || data.category === 'analysis';
const slots = single
  ? [gallery[0] ?? data.cover]
  : gallery.length
    ? gallery
    : Array.from({ length: 6 }, () => undefined);

// The analysis write-ups are authored as four numbered steps — "1. Context: …",
// "2. Problem: …" — so the structure is already in the content; rendering them
// as one blob of paragraphs threw it away. Split the label off the sentence and
// let the layout carry it. Build write-ups are plain prose: if a single
// paragraph doesn't parse as a step, the whole body falls back to prose rather
// than showing a half-stepped list.
const STEP = /^\s*\d+\.\s*([^:]{1,40}):\s*([\s\S]+)$/;
const parsedSteps = data.body.map((p) => {
  const m = p.match(STEP);
  return m ? { label: m[1].trim(), text: m[2].trim() } : null;
});
const steps = parsedSteps.every((s) => s !== null)
  ? (parsedSteps as { label: string; text: string }[])
  : null;

// Shots are cut into named runs so a deliberate set — the empty states, the
// admin side — can carry a heading that says what it is. A project with no
// groups declared renders as one unnamed run, exactly as before.
const captions = data.captions ?? [];
const boundaries = data.galleryGroups ?? [];
type Section = { label?: string; items: { img: (typeof slots)[number]; i: number }[] };
const sections: Section[] = [];
slots.forEach((img, i) => {
  const start = boundaries.find((b) => b.at === i + 1);
  if (start || sections.length === 0) sections.push({ label: start?.label, items: [] });
  sections[sections.length - 1].items.push({ img, i });
});
---

<Base title={`${data.title} | ${t(lang).meta.home}`} description={data.summary}>
  <main id="main" class="detail">
    <div class="inner">
      <div class="topbar">
        {/* The grid shows every project, so there is no filter state to carry
            back — the link just lands on the work section. */}
        <a href={localizePath('/#work', lang)} class="pill" data-astro-reload
          >{copy.back}</a
        >
      </div>

      {
        data.stats && data.stats.length > 0 && (
          <div class="stats">
            {data.stats.map((s) => (
              <div class="stat">
                <div class="stat-value">{s.value}</div>
                <div class="stat-label">{s.label}</div>
              </div>
            ))}
          </div>
        )
      }

      <h1 data-headline><span class="hl">{data.headline}</span></h1>

      {/* The project's facts as a band the reader crosses once, rather than a
          fixed-width sidebar running alongside the text. The rail forced a
          second column grid onto the page that shared no edge with the stat bar
          above it or the gallery below, which is what made the layout read as
          unaligned. */}
      <dl class="spec">
        <div class="spec-field">
          <dt>{copy.client}</dt>
          <dd>{copy.clientValue[data.client]}</dd>
        </div>
        <div class="spec-field">
          <dt>{copy.stack}</dt>
          <dd class="chips">
            {data.stack.map((s) => <span>{s}</span>)}
          </dd>
        </div>
        <div class="spec-field">
          <dt>{copy.year}</dt>
          <dd>{data.year}</dd>
        </div>
        {
          data.status && (
            <div class="spec-field">
              <dt>{copy.status}</dt>
              <dd>{copy.statusValue[data.status]}</dd>
            </div>
          )
        }
        {
          data.link && (
            <div class="spec-field">
              <dt>{copy.link}</dt>
              <dd>
                <a class="m-link" href={data.link} target="_blank" rel="noopener">
                  {data.link.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                </a>
              </dd>
            </div>
          )
        }
      </dl>

      {/* Open, always. The case study is the evidence the page exists to show;
          folding it behind a toggle put a button where the proof should be. */}
      <section class="case" aria-labelledby="case-study">
        <h2 class="cs-heading" id="case-study">{copy.caseStudy}</h2>
        {
          steps ? (
            <ol class="steps">
              {steps.map((s) => (
                <li class="step">
                  <div class="step-label">{s.label}</div>
                  <p>{s.text}</p>
                </li>
              ))}
            </ol>
          ) : (
            <div class="body">{data.body.map((p) => <p>{p}</p>)}</div>
          )
        }
      </section>

      {
        video ? (
          <div class="gallery is-single" data-gallery>
            <VideoSlot
              src={video.src}
              width={video.width}
              height={video.height}
              label={copy.screen(data.title, 1)}
              data-gallery-item
            />
          </div>
        ) : (
          sections.map((section) => (
            <div class="shots">
              {section.label && <h2 class="shots-title">{section.label}</h2>}
              <div class:list={['gallery', single && 'is-single']} data-gallery>
                {section.items.map(({ img, i }) => (
                  <figure class="shot">
                    <ImageSlot
                      src={img}
                      alt={captions[i] ?? copy.screen(data.title, i + 1)}
                      aspect={img ? 'auto' : '4 / 3'}
                      grayscale={!img}
                      sizes={single ? '100vw' : '(max-width: 820px) 100vw, 46vw'}
                      placeholder={copy.shot(i + 1)}
                      data-gallery-item
                      {...img
                        ? {
                            'data-zoom': true,
                            role: 'button',
                            tabindex: 0,
                            'aria-label': `${copy.zoom}: ${captions[i] ?? copy.screen(data.title, i + 1)}`,
                          }
                        : {}}
                    />
                    {captions[i] && <figcaption>{captions[i]}</figcaption>}
                  </figure>
                ))}
              </div>
            </div>
          ))
        )
      }

      {/* Full-screen viewer for the shots above. Markup ships with the page and
          stays hidden until a tile is clicked; src is filled in by lightbox.ts
          so nothing full-size is fetched on load. Placeholder tiles and the
          video aren't zoomable, so a project with neither gets an inert node. */}
      <div class="lightbox" data-lightbox hidden>
        <div class="lb-scrim" data-lightbox-backdrop></div>
        <button class="lb-btn lb-close" type="button" data-lightbox-close aria-label={copy.lbClose}
          >✕</button
        >
        <button
          class="lb-btn lb-prev"
          type="button"
          data-lightbox-step="-1"
          aria-label={copy.lbPrev}>‹</button
        >
        <img class="lb-img" data-lightbox-img alt="" />
        <button
          class="lb-btn lb-next"
          type="button"
          data-lightbox-step="1"
          aria-label={copy.lbNext}>›</button
        >
        <div class="lb-count" data-lightbox-count></div>
      </div>

    </div>
  </main>
  {/* Outside <main> for the same reason as on the home page: the glow is fixed,
      and a transformed ancestor would capture it. */}
  <Footer />
</Base>

<style>
  .detail {
    padding: 40px clamp(24px, 7vw, 120px) 120px;
  }
  /* 1200, not 1440: the reading measure tops out around 880, so the wider
     container left a column of nothing on the outer edge that read as an
     unfilled slot rather than a margin. Every block below shares these edges. */
  .inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 10px 22px;
    background:
      linear-gradient(var(--color-surface), var(--color-surface)) padding-box,
      var(--flow-ring) border-box;
    animation: var(--flow-spin);
    white-space: nowrap;
    color: var(--color-ink);
  }
  @media (pointer: coarse) {
    .pill {
      min-height: 44px;
    }
  }
  /* auto-fit, not a fixed three: a project carries however many real numbers it
     has, and the bar shouldn't be padded out to three with filler to keep the
     row full. */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(16px, 3vw, 32px);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 24px;
    border: 1px solid transparent;
    border-radius: 14px;
    background:
      linear-gradient(var(--color-surface), var(--color-surface)) padding-box,
      var(--flow-ring) border-box;
    animation: var(--flow-spin);
  }
  .stat-value {
    font-size: clamp(20px, 2.4vw, 28px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .stat-label {
    font-size: 13px;
    color: var(--color-ink-muted);
  }
  /* ---- Spec row ---------------------------------------------------------
     One band, full container width, ruled top and bottom. Fields flow into
     however many columns fit, so the same markup gives four across on a desk
     and two on a phone without a breakpoint. */
  .spec {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 24px 32px;
    margin: 0;
    padding-block: 24px;
    /* Width on the block edges only, so the flow rule paints as two horizontal
       lines and never as a box. */
    border: 0 solid transparent;
    border-block-width: 1px;
    border-image: var(--flow-rule-x) 1;
    animation: var(--flow-slide);
  }
  .spec-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  /* Label and value used to be the same 13px, separated only by weight, which
     left the whole rail reading as one grey texture. Small caps label over a
     larger value gives the pair an actual hierarchy. */
  .spec dt {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .spec dd {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
  }
  /* The website value is the row's only interactive field — underline marks it
     as a link without leaning on colour alone. */
  .m-link {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    /* URLs are Latin and must stay LTR even inside the Arabic spec row. */
    direction: ltr;
    unicode-bidi: isolate;
    width: fit-content;
    transition: color 0.2s ease;
  }
  .m-link:hover {
    color: var(--color-accent);
  }
  /* Wrapping row now that the fields sit side by side: a stacked column of
     chips would blow the spec row's height out to whatever the longest stack
     list happens to be. */
  .chips {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 8px;
  }
  .chips span {
    font-size: 12px;
    letter-spacing: 0.02em;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 10px;
    background:
      linear-gradient(var(--color-surface), var(--color-surface)) padding-box,
      var(--flow-ring) border-box;
    animation: var(--flow-spin);
    white-space: nowrap;
  }
  /* Chips are a cluster; staggering their phase keeps them from pulsing as one
     block. */
  .chips span:nth-child(2n) {
    animation-delay: calc(var(--flow-dur) / -3);
  }
  .chips span:nth-child(3n) {
    animation-delay: calc(var(--flow-dur) / -1.6);
  }
  /* Headlines are full sentences, not two-word titles — at display size a long
     one ate the fold and read as a banner instead of a sentence. Smaller type
     with looser leading and a narrower measure keeps it a headline you read. */
  h1 {
    margin: 0;
    font-size: clamp(28px, 3.2vw, 44px);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.22;
    max-width: 780px;
    /* Headlines may carry authored line breaks (YAML block scalars); pre-line
       honours them while still wrapping long lines normally. */
    white-space: pre-line;
  }
  /* ---- Case study ------------------------------------------------------- */
  .case {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 68ch;
  }
  .cs-heading {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  /* The step number is authored into the copy as "1." — reading it off a
     counter instead keeps the numbering out of the sentence, so the label can
     sit on its own line where the eye can use it as a landmark. */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .step-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .step-label::before {
    counter-increment: step;
    content: counter(step) '. ';
    color: var(--color-ink-muted);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  /* Open by default, so the case study is the page's primary reading matter and
     stops using the muted token that belongs to labels. */
  .step p,
  .body p {
    margin: 0;
    font-size: 18px;
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-ink) 85%, var(--color-canvas));
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 880px;
  }
  .body p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }
  /* Masonry columns rather than a row grid: shots range from tall app screens
     (0.8) to wide dashboards (1.4), and a row grid leaves a ragged gap under
     whichever tile in a pair is shorter. Columns pack each shot against the one
     above it, so nothing is cropped and no row-sized holes open up. */
  .gallery {
    columns: 2;
    column-gap: 32px;
  }
  /* Analysis work is one artefact — shown whole, no column split. */
  .gallery.is-single {
    columns: 1;
  }
  /* The figure is what breaks between columns now, not the tile: a caption that
     gets orphaned into the next column is worse than a ragged column edge. */
  .shot {
    margin: 0 0 32px;
    break-inside: avoid;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .gallery.is-single .shot {
    margin-bottom: 0;
  }
  .shot figcaption {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-ink-muted);
    /* Held to the tile's own width so the line reads as belonging to the shot
       above it rather than to the column. */
    max-width: 62ch;
  }
  /* A named run of shots. The rule under the heading carries the same flowing
     hairline as the spec row, so the two structural bands on the page match. */
  .shots {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .shots + .shots {
    margin-top: 24px;
  }
  .shots-title {
    margin: 0;
    padding-bottom: 14px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    border: 0 solid transparent;
    border-block-end-width: 1px;
    border-image: var(--flow-rule-x) 1;
    animation: var(--flow-slide);
  }
  /* The tile is a child component, so its root needs :global to be reached. */
  .gallery :global(.imgslot) {
    break-inside: avoid;
  }
  @media (max-width: 820px) {
    .gallery {
      columns: 1;
    }
  }

  /* ---- Full-screen gallery viewer ---- */
  /* Tiles advertise themselves as zoomable; the placeholder tiles don't get this. */
  .gallery :global([data-zoom]) {
    cursor: zoom-in;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    justify-items: center;
    padding: clamp(12px, 3vw, 40px);
    opacity: 0;
    transition: opacity 0.22s var(--ease, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .lightbox.is-open {
    opacity: 1;
  }
  .lb-scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-ink) 92%, transparent);
    backdrop-filter: blur(6px);
  }
  /* The picture fills whatever the arrows and padding leave, never crops. */
  .lb-img {
    position: relative;
    grid-column: 2;
    max-width: 100%;
    max-height: calc(100dvh - clamp(24px, 6vw, 80px));
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.65);
    transform: scale(0.98);
    transition: transform 0.22s var(--ease, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .lightbox.is-open .lb-img {
    transform: scale(1);
  }
  .lb-btn {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-paper, #fff) 30%, transparent);
    background: color-mix(in srgb, var(--color-ink) 55%, transparent);
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }
  .lb-btn:hover {
    background: color-mix(in srgb, var(--color-accent) 85%, transparent);
    color: var(--color-ink);
    transform: scale(1.06);
  }
  .lb-prev {
    grid-column: 1;
  }
  .lb-next {
    grid-column: 3;
  }
  .lb-close {
    position: absolute;
    top: clamp(12px, 3vw, 28px);
    inset-inline-end: clamp(12px, 3vw, 28px);
    font-size: 18px;
  }
  .lb-count {
    position: absolute;
    bottom: clamp(12px, 3vw, 28px);
    left: 50%;
    transform: translateX(-50%);
    color: color-mix(in srgb, #fff 75%, transparent);
    font-size: 13px;
    letter-spacing: 0.06em;
  }
  /* Phones: arrows sit over the bottom corners so the picture keeps the width. */
  @media (max-width: 640px) {
    .lightbox {
      grid-template-columns: 1fr;
    }
    .lb-img {
      grid-column: 1;
    }
    .lb-btn.lb-prev,
    .lb-btn.lb-next {
      position: absolute;
      bottom: 18px;
      grid-column: 1;
    }
    .lb-prev {
      inset-inline-start: 18px;
    }
    .lb-next {
      inset-inline-end: 18px;
    }
    .lb-count {
      bottom: 32px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox,
    .lb-img {
      transition: none;
    }
  }
</style>
