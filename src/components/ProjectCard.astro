---
// A plate in the catalogue run.
//
// Not a card: every plate carries the same label schema in the same order (year,
// type, status, stack), and it is the schema, repeated without exception, that
// makes six entries read as one collection instead of six tiles. The label
// column states fact; nothing in it sells.
//
// The media is the plate, and it wipes open from its bottom edge as it arrives.
// The wipe is a change of state, which is the beat here; a fade would only be an
// introduction. plate.ts owns the trigger.
import ImageSlot from './ImageSlot.astro';
import VideoSlot from './VideoSlot.astro';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, localizePath, t } from '../i18n/ui';
import { localizeProject } from '../i18n/project';
import { projectSlug } from '../i18n/slug';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Position in the run, printed as the plate number. */
  index: number;
  /** Ledger ids this plate releases as the reader reaches it, space separated. */
  stamp?: string;
}

const { project, index, stamp } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const data = localizeProject(project.data, lang);
const detail = t(lang).detail;
const href = localizePath(`/work/${projectSlug(project.id)}/`, lang);

// Two digits so the run keeps one column edge down the page. This is a printed
// catalogue number, not a section counter.
const plateNo = String(index + 1).padStart(2, '0');
---

<article class="plate" data-stamp={stamp}>
  <div class="plate-label">
    <span class="plate-n">{plateNo}</span>
    {/* The title is drawn twice on purpose. The link carries the real text and
        renders as outline only; the span above it is the same text in solid ink,
        revealed by a mask whose edge rides the run's scroll progress. Two layers
        rather than an animated colour because the beat is a moving edge, and a
        colour cannot have one. The span is decorative and aria-hidden: the link
        underneath is the only copy assistive tech ever sees. */}
    <h3 class="plate-title">
      <a href={href} data-project-link data-project-name={data.title} data-astro-reload>{data.title}</a>
      <span class="plate-title-fill" aria-hidden="true">{data.title}</span>
    </h3>

    <dl class="plate-spec">
      <dt>{detail.year}</dt>
      <dd>{data.year}</dd>
      <dt>{detail.client}</dt>
      <dd>{detail.clientValue[data.client]}</dd>
      {
        data.status && (
          <>
            <dt>{detail.status}</dt>
            <dd>{detail.statusValue[data.status]}</dd>
          </>
        )
      }
      <dt>{detail.stack}</dt>
      <dd>{data.stack.slice(0, 4).join(', ')}</dd>
    </dl>

    <p class="plate-note">{data.summary}</p>
  </div>

  {/* The plate takes the shape of what is on it. No forced ratio and no crop:
      a 16/10 tile with object-fit:cover cut the edges off every cover, which on
      a dashboard means cutting off the part that says what it is. Each slot
      carries the asset's own proportions instead, so the whole frame is shown
      and the plates differ in height, which is what a catalogue of different
      work actually looks like. */}
  <a class="plate-media" href={href} data-project-link data-project-name={data.title} data-astro-reload aria-hidden="true" tabindex="-1">
    {
      !data.cover && data.video ? (
        <VideoSlot
          src={data.video.src}
          width={data.video.width}
          height={data.video.height}
          label={data.title}
          radius={10}
        />
      ) : (
        <ImageSlot
          src={data.cover}
          alt={data.title}
          aspect="auto"
          radius={10}
          placeholder={`Drop ${data.title} mockup`}
        />
      )
    }
  </a>
</article>
