---
import ImageSlot from './ImageSlot.astro';
import VideoSlot from './VideoSlot.astro';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, localizePath } from '../i18n/ui';
import { localizeProject } from '../i18n/project';
import { projectSlug } from '../i18n/slug';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const data = localizeProject(project.data, lang);
const href = localizePath(`/work/${projectSlug(project.id)}/`, lang);
---

<article class="project-card" data-cat={data.category}>
  <a
    href={href}
    class="card-link"
    data-project-link
    data-project-name={data.title}
    data-astro-reload
  >
    {/* Fixed 16/10 tile so every card in the grid is the same size — the source
        covers range from 1.20 to 2.08, and letting each keep its own ratio left
        the row ragged and the titles off one baseline. Images fill the tile with
        object-fit: cover. Coverless projects get the same tile as a placeholder. */}
    {/* The tile runs its own flow-ring animation, so the hover shake lives on a
        wrapper — one `animation` property can't carry both. */}
    <div class="card-media">
      {
        !data.cover && data.video ? (
          <VideoSlot
            src={data.video.src}
            width={data.video.width}
            height={data.video.height}
            label={data.title}
            radius={10}
            aspect="16 / 10"
            fit="cover"
          />
        ) : (
          <ImageSlot
            src={data.cover}
            alt={data.title}
            aspect="16 / 10"
            radius={10}
            placeholder={`Drop ${data.title} mockup`}
          />
        )
      }
    </div>
    <div class="meta">
      <span class="name">
        <span class="pswipe" aria-hidden="true"></span>
        <span class="name-text">{data.title}</span>
      </span>
      <span class="tags">
        {data.tags.slice(0, 2).map((t) => <span>{t}</span>)}
      </span>
    </div>
  </a>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card-link {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
    color: inherit;
  }
  /* Hovering the card gives the cover a short zigzag nudge that damps back to
     rest — the swing halves each pass so it settles rather than stopping dead.
     Runs once per hover; leaving mid-shake drops the animation and the wrapper
     snaps back to its untransformed state. */
  .card-media {
    transform-origin: 50% 60%;
    will-change: transform;
  }
  .card-link:hover .card-media,
  .card-link:focus-visible .card-media {
    animation: cardShake 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  }
  @keyframes cardShake {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
    15% {
      transform: translate3d(-5px, 0, 0) rotate(-0.7deg);
    }
    32% {
      transform: translate3d(4px, 0, 0) rotate(0.55deg);
    }
    50% {
      transform: translate3d(-2.5px, 0, 0) rotate(-0.35deg);
    }
    68% {
      transform: translate3d(1.5px, 0, 0) rotate(0.2deg);
    }
    84% {
      transform: translate3d(-0.6px, 0, 0) rotate(-0.08deg);
    }
    100% {
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card-link:hover .card-media,
    .card-link:focus-visible .card-media {
      animation: none;
    }
  }
  /* Title over tags rather than beside them: the two ran into each other on
     narrow cards, and stacking keeps every card's title on the same baseline
     regardless of how long its tag list is. */
  .meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 0 2px;
  }
  .name {
    font-size: 15px;
    font-weight: 600;
    position: relative;
    display: inline-block;
    padding: 0 4px;
  }
  .name-text {
    position: relative;
    z-index: 1;
  }
  .tags {
    display: flex;
    gap: 18px;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
  }
</style>
