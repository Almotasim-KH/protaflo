---
// Renders a responsive astro:assets <Image/> when a real asset is provided,
// otherwise a neutral placeholder tile (mirrors the design's image-slot). Drop a
// real image into a project's frontmatter and it upgrades automatically.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

// Extends div attributes so callers can pass motion hooks (data-gallery-item &c.)
// straight through to the tile without this component knowing about them.
interface Props extends HTMLAttributes<'div'> {
  src?: ImageMetadata;
  alt?: string;
  radius?: number;
  aspect?: string;
  grayscale?: boolean;
  placeholder?: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt = '',
  radius = 20,
  aspect = '4 / 3',
  grayscale = false,
  placeholder = 'Image',
  sizes = '(max-width: 900px) 100vw, 50vw',
  loading = 'lazy',
  class: className = '',
  ...rest
} = Astro.props;

// aspect="auto" keeps the asset's own proportions — nothing is cropped, the tile
// grows to whatever shape the file is (tall app screenshots, wide dashboards).
// Placeholders have no intrinsic size, so they keep the 4/3 design tile.
const natural = aspect === 'auto';
const ratio = natural ? (src ? `${src.width} / ${src.height}` : '4 / 3') : aspect;

// Never ask Astro to upscale past the source; UI screenshots stay legible at 2x.
const widths = [480, 800, 1200, 1600].filter((w) => !src || w <= src.width);
---

<div
  class:list={['imgslot', grayscale && 'is-grayscale', natural && src && 'is-natural', className]}
  style={`--r:${radius}px;--aspect:${ratio}`}
  {...rest}
>
  {
    src ? (
      <Image src={src} alt={alt} sizes={sizes} widths={widths} loading={loading} />
    ) : (
      <span class="ph">{placeholder}</span>
    )
  }
</div>

<style>
  /* The tile is ringed by a flowing hairline (see --flow-ring in global.css).
     The fill sits on padding-box, the gradient on border-box, so the image is
     framed by the moving edge instead of overlapping it. */
  .imgslot {
    position: relative;
    border-radius: var(--r);
    overflow: hidden;
    aspect-ratio: var(--aspect);
    border: 1px solid transparent;
    background:
      linear-gradient(var(--fill, #ede9e0), var(--fill, #ede9e0)) padding-box,
      var(--flow-ring) border-box;
    animation: var(--flow-spin);
    box-shadow: var(--shadow-tile);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .imgslot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Tile already carries the asset's own ratio, so `contain` crops nothing and
     guards against subpixel rounding on odd sizes. */
  .is-natural {
    --fill: transparent;
  }
  .is-natural :global(img) {
    object-fit: contain;
  }
  .ph {
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--color-ink-muted);
    padding: 0 16px;
    text-align: center;
  }
</style>
