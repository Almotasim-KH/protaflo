---
// A chapter opener: rule, numeral, running head, title.
//
// The numeral is information on this page rather than decoration — the feature
// is chaptered and the folio reports the same number back in the margin, so the
// reader always knows which of four they are in.
interface Props {
  /** Roman or Arabic-Indic numeral, already localised by the caller. */
  numeral: string;
  /** Running head, repeated by the folio. */
  run: string;
  /**
   * The chapter's own title, the largest type in the section. A newline in the
   * string is an authored line break: the two halves are set on their own lines
   * and sweep in one after the other, rather than wrapping wherever the measure
   * happens to run out.
   */
  title: string;
  /**
   * Id for the <h2>. A section that wants an accessible name points its
   * `aria-labelledby` here rather than adding a second, visually hidden heading
   * of its own — two <h2> elements carrying the same words is what a screen
   * reader reads out twice and what a crawler sees as two landmarks.
   */
  titleId?: string;
}

const { numeral, run, title, titleId } = Astro.props;

const titleLines = title.split('\n');

// A chapter whose title IS its running head would print the same words twice,
// once small and once large. Where they match, only the title is set — the folio
// still gets the running head from the data attribute below, which is the only
// place it was ever read from.
const showRun = run.trim().toLocaleLowerCase() !== title.trim().toLocaleLowerCase();
---

<header
  class:list={['chapter-open', { 'no-run': !showRun }]}
  data-chapter-num={numeral}
  data-chapter-title={run}
>
  <span class="chapter-num">{numeral}</span>
  {showRun && <span class="chapter-run">{run}</span>}
  <h2 class="chapter-title" id={titleId} data-headline>
    {
      titleLines.map((line, i) => (
        <span class="chapter-line" style={i ? `--d:${i * 0.18}s` : undefined}>
          <span class="hl">{line}</span>
        </span>
      ))
    }
  </h2>
</header>
