---
// The KPI plate — the page's peak.
//
// Six figures, each with the project it came from, landing one after another as
// the plate arrives. It is the only full ground inversion after the title plate
// and it holds the most scroll room on the page.
//
// Every figure is real and sourced. Six numbers, six projects, no estimates: the
// counters only ever run toward a value that is already written into the markup,
// so the page states the same thing with JS off.
//
// The six are laid out as a stack of overlapping cards rather than a grid — the
// geometry, the z-order rule that keeps every figure readable, and the width at
// which the path gives way to a plain run all live in global.css under
// `.evidence-stack`.
import Chapter from './Chapter.astro';
import { getLangFromUrl, t } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const copy = t(lang);
const ev = copy.evidence;
const entries = copy.figures.entries;
---

<section id="evidence" class="evidence on-plate" data-ground="dark" data-evidence aria-label={ev.title}>
  <div class="evidence-inner">
    <Chapter numeral={copy.chapters.numerals[3]} run={copy.chapters.four} title={ev.title} />
    <p class="evidence-lead" data-reveal>{ev.lead}</p>

    <ul class="evidence-stack">
      {
        entries.map((e) => (
          <li class="evidence-item">
            <span class="evidence-v" data-count={e.count}>
              {e.value}
            </span>
            <span class="evidence-l">{e.label}</span>
            <span class="evidence-src">
              {ev.sourceLabel}
              <b>{e.source}</b>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
