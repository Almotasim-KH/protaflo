---
// The evidence plate — the page's peak.
//
// The margin ledger has been collecting figures for the whole scroll; here it
// lets go and the lines land in the middle of the screen, each one with the
// project it came from. It is the only full ground inversion after the title
// plate and it holds the most scroll room on the page.
//
// Every figure is real and sourced. Six numbers, six projects, no estimates: the
// counters only ever run toward a value that is already written into the markup,
// so the page states the same thing with JS off.
import Chapter from './Chapter.astro';
import { getLangFromUrl, t } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const copy = t(lang);
const ev = copy.evidence;
const entries = copy.ledger.entries;
---

<section id="evidence" class="evidence on-plate" data-ground="dark" data-evidence aria-label={ev.title}>
  <div class="evidence-inner">
    <Chapter numeral={copy.chapters.numerals[3]} run={copy.chapters.four} title={ev.title} />
    <p class="evidence-lead" data-reveal>{ev.lead}</p>

    <ul class="evidence-list">
      {
        entries.map((e) => (
          <li class="evidence-item">
            <span class="evidence-v" data-count={e.count}>
              {e.value}
            </span>
            <span class="evidence-l">{e.label}</span>
            <span class="evidence-src">
              {ev.sourceLabel}
              <b>{e.source}</b>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
