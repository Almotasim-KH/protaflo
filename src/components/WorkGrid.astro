---
import ProjectCard from './ProjectCard.astro';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, t } from '../i18n/ui';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const copy = t(getLangFromUrl(Astro.url)).work;

// The grid shows every project, ordered by `order` in the frontmatter. There is
// no discipline filter: with this few projects, hiding half the work behind a
// pill cost more than it organised.
---

<section id="work" class="work" aria-labelledby="work-title">
  <div class="head">
    <div class="eyebrow" data-reveal>{copy.eyebrow}</div>
    <h2 id="work-title" data-headline data-speed="1.14">
      <span class="hl"
        >{copy.titleLead}<span class="mark"><span class="mark-text">{copy.titleMark}</span><span
            class="mark-bg"></span></span></span
      >
    </h2>
  </div>

  <div class="grid" data-work-grid data-reveal>
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<style>
  .work {
    padding: 8px clamp(24px, 7vw, 120px) 0;
    max-width: 1440px;
    margin: 0 auto;
  }
  .head {
    padding: 40px 0 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-weight: 500;
  }
  h2 {
    margin: 0;
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    padding-bottom: 64px;
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
