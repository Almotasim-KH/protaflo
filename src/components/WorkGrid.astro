---
// Chapter one: the work, set as a catalogue run.
//
// A plate per project, each with the same label schema, so the six read as one
// collection rather than as a grid of tiles. There is no discipline filter: with
// this few projects, hiding half the work behind a pill cost more than it
// organised.
//
// Two plates carry release points for the margin ledger. The ids are attached to
// the project the figure actually came from, so a number can never appear in the
// rail beside work that did not produce it.
import Chapter from './Chapter.astro';
import ProjectCard from './ProjectCard.astro';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, t } from '../i18n/ui';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const copy = t(lang);
---

<section id="work" class="work" data-ground="light" aria-labelledby="work-title">
  <div class="work-inner">
    {
      /* The chapter's own <h2> names the section. There used to be a second,
        visually hidden <h2> here carrying the same three words purely to give
        the region an accessible name — so a screen reader announced the heading
        twice and a crawler saw two identical landmarks on one page. The label
        now points at the heading a reader can actually see. */
    }
    <Chapter
      numeral={copy.chapters.numerals[0]}
      run={copy.chapters.one}
      title={copy.work.chapterTitle}
      titleId="work-title"
    />

    {
      /* data-run is what plate.ts collects the plates from. Each plate then
        carries its own trigger, and that trigger's progress is the plate's
        title fill. */
    }
    <div class="run" data-run>
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </div>
</section>

<style>
  .work {
    padding: 0 clamp(24px, 7vw, 120px) clamp(40px, 7vw, 90px);
  }
  .work-inner {
    max-width: 1240px;
    margin: 0 auto;
  }
  .run {
    margin-top: clamp(30px, 5vw, 60px);
  }
</style>
