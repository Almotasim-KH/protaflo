---
// Chapter one: the work, set as a catalogue run.
//
// A plate per project, each with the same label schema, so the six read as one
// collection rather than as a grid of tiles. There is no discipline filter: with
// this few projects, hiding half the work behind a pill cost more than it
// organised.
//
// Two plates carry release points for the margin ledger. The ids are attached to
// the project the figure actually came from, so a number can never appear in the
// rail beside work that did not produce it.
import Chapter from './Chapter.astro';
import ProjectCard from './ProjectCard.astro';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, t } from '../i18n/ui';
import { projectSlug } from '../i18n/slug';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const copy = t(lang);

// Slug → ledger ids. Both figures below are stated in that project's own body,
// so a line can never reach the rail beside work that did not produce it. Keyed
// on the built slug (the content loader slugifies the file name), not on the
// file name itself.
const stamps: Record<string, string> = {
  'actual-revenues-of-2024': 'sources minutes',
  'camp-operations-dashboard': 'hours',
};
---

<section id="work" class="work" data-ground="light" aria-labelledby="work-title">
  <div class="work-inner">
    <Chapter
      numeral={copy.chapters.numerals[0]}
      run={copy.chapters.one}
      title={copy.work.chapterTitle}
    />
    <h2 id="work-title" class="sr-only">{copy.chapters.one}</h2>

    {/* data-run is what plate.ts collects the plates from. Each plate then
        carries its own trigger, and that trigger's progress is the plate's
        title fill. */}
    <div class="run" data-run>
      {
        projects.map((project, i) => (
          <ProjectCard
            project={project}
            index={i}
            stamp={stamps[projectSlug(project.id)]}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .work {
    padding: 0 clamp(24px, 7vw, 120px) clamp(40px, 7vw, 90px);
  }
  .work-inner {
    max-width: 1240px;
    margin: 0 auto;
  }
  .run {
    margin-top: clamp(30px, 5vw, 60px);
  }
  /* The chapter opener already carries the heading a reader sees. This one exists
     for the accessible name of the region only, so it is removed from the visual
     page rather than hidden from assistive tech. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
