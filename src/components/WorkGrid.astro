---
// Chapter one: the work, set as a catalogue run.
//
// A plate per project, each with the same label schema, so the six read as one
// collection rather than as a grid of tiles. There is no discipline filter: with
// this few projects, hiding half the work behind a pill cost more than it
// organised.
//
// Two plates carry release points for the margin ledger. The ids are attached to
// the project the figure actually came from, so a number can never appear in the
// rail beside work that did not produce it.
import Chapter from './Chapter.astro';
import ProjectCard from './ProjectCard.astro';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, t } from '../i18n/ui';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const copy = t(lang);

// The run opens on the last two plates and holds the rest behind a control at
// its head. Catalogue numbering is not resequenced for the collapsed view: a
// plate's number is its place in the whole run, so the two on show stay 05 and
// 06 and the earlier four keep 01–04 when they arrive above them. Renumbering
// per view would mean the same project answered to two different numbers
// depending on whether the reader had pressed a button.
const OPEN_WITH = 2;
const earlier = projects.slice(0, Math.max(0, projects.length - OPEN_WITH));
const opening = projects.slice(earlier.length);
---

<section id="work" class="work" data-ground="light" aria-labelledby="work-title">
  <div class="work-inner">
    {
      /* The chapter's own <h2> names the section. There used to be a second,
        visually hidden <h2> here carrying the same three words purely to give
        the region an accessible name — so a screen reader announced the heading
        twice and a crawler saw two identical landmarks on one page. The label
        now points at the heading a reader can actually see. */
    }
    <Chapter
      numeral={copy.chapters.numerals[0]}
      run={copy.chapters.one}
      title={copy.work.chapterTitle}
      titleId="work-title"
    />

    {
      /* data-run is what plate.ts collects the plates from. Each plate then
        carries its own trigger, and that trigger's progress is the plate's
        title fill. */
    }
    <div class="run" data-run>
      {
        /* The control sits at the head of the run, above everything it opens, so
          it does not move when it is pressed and the two plates already on
          screen do not jump. Rendered only when there is something behind it.

          Server-rendered expanded, then collapsed by CSS that is gated on
          `html.js` — set in the document head, before first paint, so there is
          no flash of all six. With JS off the attribute is inert, the run shows
          whole and the button hides itself: nothing is unreachable. */
      }
      {
        earlier.length > 0 && (
          <button
            type="button"
            class="run-toggle"
            data-run-toggle
            aria-controls="run-earlier"
            aria-expanded="false"
            aria-label={copy.work.moreLabel}
            data-label-more={copy.work.showMore}
            data-label-less={copy.work.showLess}
          >
            {copy.work.showMore}
          </button>
        )
      }
      {
        earlier.length > 0 && (
          <div class="run-earlier" id="run-earlier" data-run-earlier data-collapsed>
            {earlier.map((project, i) => (
              <ProjectCard project={project} index={i} />
            ))}
          </div>
        )
      }
      {
        opening.map((project, i) => (
          <ProjectCard project={project} index={earlier.length + i} />
        ))
      }
    </div>
  </div>
</section>

<style>
  .work {
    padding: 0 clamp(24px, 7vw, 120px) clamp(40px, 7vw, 90px);
  }
  .work-inner {
    max-width: 1240px;
    margin: 0 auto;
  }
  .run {
    margin-top: clamp(30px, 5vw, 60px);
  }

  /* `display: contents` rather than a wrapper with a box: the plates are a run
     of siblings separated by their own hairline rules, and putting a real
     container around four of them would have made the group read as a block
     inside the catalogue instead of as part of it. Collapsed it becomes
     `display: none`, which is also what keeps the hidden plates out of the tab
     order and out of the accessibility tree. */
  .run-earlier {
    display: contents;
  }
  /* Gated on .js — the collapse only exists where there is a button to undo it. */
  :global(html.js) .run-earlier[data-collapsed] {
    display: none;
  }

  /* Set as a line of the catalogue's own furniture, not as a call to action: the
     run is a printed list and this is the note in its margin that says the list
     continues. */
  .run-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    cursor: pointer;
    transition: color 0.2s ease;
  }
  /* The rule grows out of the label toward the margin, so the control reads as
     attached to the run rather than floating above it. */
  .run-toggle::after {
    content: '';
    width: 28px;
    height: 1px;
    background: currentColor;
    transition: width 0.2s ease;
  }
  .run-toggle:hover,
  .run-toggle:focus-visible {
    color: var(--color-ink);
  }
  .run-toggle:hover::after,
  .run-toggle:focus-visible::after {
    width: 44px;
  }
  /* No JS, no collapse — so no control either. */
  :global(html:not(.js)) .run-toggle {
    display: none;
  }
</style>
