---
import { getLangFromUrl, t } from '../i18n/ui';

const copy = t(getLangFromUrl(Astro.url)).about;

// 84px-wide hand-drawn accent scribbles (viewBox 0 0 220 120, stroke width 9,
// round caps) — one per skill row. Each one draws its own subject rather than an
// abstract squiggle: a wireframe, a trend line, angle brackets, a grid. Lines are
// deliberately off-square (a few px of drift per corner) so they read as sketched,
// not as a diagram.
// Marks are language-independent; the labels beside them come from the
// dictionary and are zipped in by index below.
const marks = [
  {
    // artboard: rough frame + toolbar rule + a block of content
    path: 'M18 26 L202 20 L206 100 L22 104 Z M20 52 L204 47 M48 76 L120 74',
  },
  {
    // trend line climbing over an axis
    path: 'M20 20 L22 102 L206 98 M40 84 L88 48 L124 68 L166 28',
  },
  {
    // angle brackets with the slash between them
    path: 'M76 26 L22 60 L76 96 M144 26 L198 60 L144 96 M128 22 L94 100',
  },
  {
    // spreadsheet: header rule plus two column rules — denser than the UI artboard
    // above so the two rectangles don't read as the same mark
    path: 'M16 24 L204 18 L208 102 L20 106 Z M18 50 L206 45 M84 21 L86 105 M148 19 L150 103',
  },
];

const skills = marks.map((m, i) => ({ ...m, ...copy.skills[i] }));
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="head">
    <div class="eyebrow" data-reveal>{copy.eyebrow}</div>
    <h2 id="about-title" data-headline data-speed="1.14"><span class="hl"
        >{copy.titleLead}<br />{copy.titleSecond}<span class="mark"><span class="mark-text"
            >{copy.titleMark}</span
          ><span class="mark-bg"></span></span></span
      ></h2>
  </div>
  <div class="cols">
    <div class="prose">
      {/* One idea per paragraph: who I am → what I do → how the work runs. */}
      {copy.paragraphs.map((para) => <p data-reveal>{para}</p>)}
    </div>
    <ul class="skills" data-reveal-stagger>
      {
        skills.map((s) => (
          <li data-reveal-item>
            {/* stroke is thinner than the old open squiggles: these marks enclose
                space, and 9 closed the gaps up at 84px wide */}
            <svg class="scribble" viewBox="0 0 220 120" fill="none" aria-hidden="true">
              <path
                d={s.path}
                stroke="var(--color-accent)"
                stroke-width="7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <div>
              <div class="s-title">{s.title}</div>
              <div class="s-desc">{s.desc}</div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    padding: 40px clamp(24px, 7vw, 120px) 64px;
    max-width: 1440px;
    margin: 0 auto;
  }
  .head {
    padding: 40px 0 16px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-weight: 500;
  }
  h2 {
    margin: 0;
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
    margin-top: 32px;
  }
  .prose {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .prose p {
    margin: 0;
    font-size: 18px;
    color: var(--color-ink-muted);
    line-height: 1.6;
    max-width: 460px;
  }
  .skills {
    list-style: none;
    margin: 0;
    padding: 56px 0 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .skills li {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .scribble {
    flex: none;
    width: 84px;
    height: auto;
  }
  .s-title {
    font-size: 18px;
    font-weight: 600;
  }
  .s-desc {
    font-size: 15px;
    color: var(--color-ink-muted);
  }
  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .skills {
      padding-top: 0;
    }
  }
</style>
