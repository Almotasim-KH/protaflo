---
import Chapter from './Chapter.astro';
import { getLangFromUrl, t } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const all = t(lang);
const copy = all.about;

// 84px-wide hand-drawn accent scribbles (viewBox 0 0 220 120, stroke width 9,
// round caps) — one per skill row. Each one draws its own subject rather than an
// abstract squiggle: a wireframe, a trend line, angle brackets, a grid. Lines are
// deliberately off-square (a few px of drift per corner) so they read as sketched,
// not as a diagram.
// Marks are language-independent; the labels beside them come from the
// dictionary and are zipped in by index below.
const marks = [
  {
    // artboard: rough frame + toolbar rule + a block of content
    path: 'M18 26 L202 20 L206 100 L22 104 Z M20 52 L204 47 M48 76 L120 74',
  },
  {
    // trend line climbing over an axis
    path: 'M20 20 L22 102 L206 98 M40 84 L88 48 L124 68 L166 28',
  },
  {
    // angle brackets with the slash between them
    path: 'M76 26 L22 60 L76 96 M144 26 L198 60 L144 96 M128 22 L94 100',
  },
  {
    // spreadsheet: header rule plus two column rules — denser than the UI artboard
    // above so the two rectangles don't read as the same mark
    path: 'M16 24 L204 18 L208 102 L20 106 Z M18 50 L206 45 M84 21 L86 105 M148 19 L150 103',
  },
  {
    // AI: the four-point spark, drawn twice — one large, one small trailing it.
    // Curves instead of straight rays so it stays hand-drawn like the rest.
    path: 'M92 20 C 97 50, 106 58, 144 64 C 106 70, 97 78, 92 108 C 87 78, 78 70, 40 64 C 78 58, 87 50, 92 20 Z M180 16 C 182 29, 186 32, 199 34 C 186 36, 182 39, 180 52 C 178 39, 174 36, 161 34 C 174 32, 178 29, 180 16 Z',
  },
];

const skills = marks.map((m, i) => ({ ...m, ...copy.skills[i] }));
---

<section id="about" class="about" data-ground="light" aria-label={all.chapters.two}>
  <Chapter numeral={all.chapters.numerals[1]} run={all.chapters.two} title={copy.chapterTitle} />
  <div class="cols">
    <div class="prose">
      {/* Opening → goal → thesis. The introduction leads at a larger size and
          the two paragraphs under it carry the argument, so the column has a
          hierarchy instead of an even run of paragraphs. */}
      <p class="proof" data-reveal data-stamp="people">
        {copy.greeting && <span>{copy.greeting}</span>}
        {copy.proof.map((line) => <span>{line}</span>)}
      </p>
      <p data-reveal>{copy.paragraph}</p>
      <p data-reveal>{copy.closer}</p>
    </div>
    <ul class="skills" data-reveal-stagger data-draw-group>
      {
        skills.map((s) => (
          <li data-reveal-item>
            {/* stroke is thinner than the old open squiggles: these marks enclose
                space, and 9 closed the gaps up at 84px wide */}
            <svg class="scribble" viewBox="0 0 220 120" fill="none" aria-hidden="true" data-draw>
              <path
                d={s.path}
                stroke="var(--color-accent)"
                stroke-width="7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <div>
              <div class="s-title">{s.title}</div>
              <div class="s-desc">{s.desc}</div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Same measure and the same gutters as the other chapters, so one column edge
     runs the length of the feature instead of each section finding its own. */
  .about {
    padding: clamp(30px, 5vw, 60px) clamp(24px, 7vw, 120px) clamp(50px, 8vw, 96px);
    max-width: calc(1240px + 2 * clamp(24px, 7vw, 120px));
    margin: 0 auto;
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
    margin-top: clamp(30px, 5vw, 60px);
  }
  .prose {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  /* Full-strength ink throughout: the section is one continuous statement, and
     setting the paragraphs under the opening in the muted grey made them read
     as supporting notes to it rather than the rest of the same voice. */
  .prose p {
    margin: 0;
    font-size: 18px;
    color: var(--color-ink);
    line-height: 1.6;
    max-width: 460px;
  }
  /* One step up from the paragraphs below it: the opening introduces the voice
     the rest of the section speaks in, and each line gets its own row because
     wrapped together they read as one long run-on. */
  .prose p.proof {
    font-size: 21px;
    line-height: 1.5;
    max-width: 480px;
  }
  .proof span {
    display: block;
  }
  /* Every line in the opening carries the same ink: the greeting and the two
     lines under it are one voice, and dropping the later ones to the muted grey
     read as an aside to the first. */
  .proof span + span {
    margin-top: 10px;
  }
  /* No top offset: the prose and the skill marks are two halves of one row, so
     they start on the same line rather than the list hanging below the text. */
  .skills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .skills li {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .scribble {
    flex: none;
    width: 84px;
    height: auto;
  }
  .s-title {
    font-size: 18px;
    font-weight: 600;
  }
  .s-desc {
    font-size: 15px;
    color: var(--color-ink-muted);
  }
  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .skills {
      padding-top: 0;
    }
  }
</style>
