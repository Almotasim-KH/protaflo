---
// Floating centered pill (name + CV), flanked by two frameless buttons: the
// language switch on the left, "Let's Talk" on the right. Hides on scroll-down
// past the hero (Module 5).
import { getLangFromUrl, localizePath, t } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const copy = t(lang).nav;
const cvHref = '/cv.pdf';

// Under ~400px the full name cannot fit between the two flanking buttons at any
// readable size, so the pill falls back to the first name. Split here rather
// than in the i18n table so a translator still edits one string.
const brandShort = copy.brand.split(' ')[0];

// The switch points at the same page in the other language — localizePath drops
// or adds the /ar prefix, so /work/budgettr/ ↔ /ar/work/budgettr/ instead of
// bouncing the reader back to the home page.
const other = lang === 'en' ? 'ar' : 'en';
const otherHref = localizePath(Astro.url.pathname, other);
---

<div class="navbar">
  {/* Left and right here are physical, not logical: the pill stays centred and
      these two keep their sides in both reading directions, so the switch is
      always in the same corner whichever language you are in. */}
  {/* Full reload: direction, fonts and every motion module are set up at
      document level, so a client-side swap would leave the old dir in place. */}
  <a
    href={otherHref}
    class="float lang"
    lang={other}
    hreflang={other}
    aria-label={copy.switchLabel}
    data-astro-reload>{copy.switchTo}</a
  >

  <nav data-nav aria-label="Primary">
    <a href={localizePath('/', lang)} class="brand"><span class="b-full">{copy.brand}</span><span class="b-short">{brandShort}</span></a>
    <div class="nav-links">
      <a href={cvHref} class="link">{copy.cv}</a>
    </div>
  </nav>

  <a href={localizePath('/#contact', lang)} class="float cta">{copy.cta}</a>
</div>

<style>
  .navbar {
    position: fixed;
    top: 24px;
    left: 0;
    right: 0;
    z-index: 30;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    /* No `gap` on purpose: the CV link collapses away past the fold, and a gap
       would hold its 40px open around nothing. The spacing lives on .nav-links
       so it collapses with the link it belongs to. */
    /* Translucent glass so headlines scrolling under the pill read as intentional
       depth, not a hard white block slicing them in half. */
    background:
      linear-gradient(
          color-mix(in srgb, var(--color-surface) 72%, transparent),
          color-mix(in srgb, var(--color-surface) 72%, transparent)
        )
        padding-box,
      var(--flow-ring) border-box;
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid transparent;
    border-radius: 999px;
    animation: var(--flow-spin);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    /* Logical, not physical: the 28px is the breathing room BEFORE the name and
       the 12px is the tighter side against the CV chip, so in Arabic the pair has
       to flip with the text. As `10px 12px 10px 28px` it did not, and the Arabic
       name sat 13px off the right edge with 163px of air on the other side. */
    padding-block: 10px;
    padding-inline: 28px 12px;
    will-change: transform;
    /* Asymmetric on purpose: each state owns the transition INTO it. This one runs
       on the way back — slower and softer, so the nav settles rather than snaps. */
    transition:
      transform 0.78s cubic-bezier(0.22, 1, 0.32, 1),
      opacity 0.55s ease-out,
      padding-inline 0.5s cubic-bezier(0.22, 1, 0.32, 1);
  }
  /* Once CV collapses away there is nothing left for the 28/12 split to balance
     against, so the pill closes to even padding around the name alone. */
  /* Two values because the resting padding differs by width; both close to an
     even pill once CV is gone. */
  @media (min-width: 561px) {
    nav.is-past-fold {
      padding-inline: 20px;
    }
  }
  @media (max-width: 560px) {
    nav.is-past-fold {
      padding-inline: 14px;
    }
  }
  /* nav.ts toggles this while scrolling down past the hero — leaving is quicker,
     it should get out of the reader's way without drawing attention. */
  nav.is-hidden {
    transform: translateY(calc(-100% - 32px));
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.42s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.28s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    nav,
    .nav-links,
    nav.is-past-fold .nav-links {
      transition: none;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
    color: var(--color-ink);
  }
  /* Only one of the two ever renders, so the accessible name of the link is
     always exactly what is on screen. */
  .b-short {
    display: none;
  }
  /* CV belongs to the top of the page. nav.ts adds .is-past-fold once the reader
     is half a hero down; the link slides out and the pill closes over it, and the
     whole thing reverses on the way back up. max-width, not display, so the pill
     resizes with the same easing it moves with. */
  .nav-links {
    display: flex;
    align-items: center;
    margin-inline-start: 40px;
    max-width: 12rem;
    overflow: hidden;
    visibility: visible;
    transition:
      max-width 0.5s cubic-bezier(0.22, 1, 0.32, 1),
      margin-inline-start 0.5s cubic-bezier(0.22, 1, 0.32, 1),
      opacity 0.28s ease-out,
      visibility 0s;
  }
  nav.is-past-fold .nav-links {
    max-width: 0;
    margin-inline-start: 0;
    opacity: 0;
    pointer-events: none;
    /* Held until the collapse finishes, then hard-hidden — a 0-width link that is
       still `visible` stays in the tab order and in the accessibility tree. */
    visibility: hidden;
    transition:
      max-width 0.5s cubic-bezier(0.22, 1, 0.32, 1),
      margin-inline-start 0.5s cubic-bezier(0.22, 1, 0.32, 1),
      opacity 0.28s ease-out,
      visibility 0s linear 0.5s;
  }
  .link {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    padding: 6px 12px;
    text-decoration: none;
    border-radius: 6px;
    white-space: nowrap;
  }
  .link:hover {
    background: var(--color-accent);
  }

  /* ---- The two flanking buttons ----
     Closer to the hero's deco marks than to the pill: a travelling hairline, a
     coloured halo, and a pane thin enough that whatever is behind shows through,
     so they sit IN the background rather than on top of it. The fill is not
     decoration — the nav floats over both the dark hero and the cream sections,
     and it is what keeps one ink label legible on both. */
  .float {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    padding: 10px 20px;
    border: 1px solid transparent;
    border-radius: 999px;
    background:
      linear-gradient(var(--pane), var(--pane)) padding-box,
      var(--flow-ring) border-box;
    --pane: color-mix(in srgb, var(--color-surface) 58%, transparent);
    backdrop-filter: blur(10px) saturate(1.3);
    -webkit-backdrop-filter: blur(10px) saturate(1.3);
    animation: var(--flow-spin);
    /* The same halo the deco shapes carry, at a fraction of the strength. */
    filter: drop-shadow(0 0 10px rgba(232, 245, 68, 0.3));
    /* --pane is not registered with @property, so it cannot tween; the halo
       carries the hover instead and the pane snaps under it. */
    transition: filter 0.28s var(--ease-brand);
  }
  .float:hover,
  .float:focus-visible {
    --pane: color-mix(in srgb, var(--color-surface) 86%, transparent);
    filter: drop-shadow(0 0 18px rgba(232, 245, 68, 0.55));
  }
  .lang {
    left: clamp(16px, 4vw, 48px);
    /* Always labelled in the language it leads to, so it always renders in the
       other script — pin a stack that covers both. */
    font-family: var(--font-ar);
  }
  /* The primary action carries a wash of accent inside the pane, so it reads as
     the loud one without becoming a solid yellow chip. */
  .cta {
    right: clamp(16px, 4vw, 48px);
    --pane: color-mix(in srgb, var(--color-accent) 62%, transparent);
  }
  .cta:hover,
  .cta:focus-visible {
    --pane: var(--color-accent);
  }
  /* Both flanks leave with the pill — nav.ts only touches [data-nav], so :has
     relays the state across to its siblings. */
  .navbar:has([data-nav].is-hidden) .float {
    transform: translateY(calc(-50% - 120px));
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.42s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.28s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .float {
      animation: none;
      transition: none;
    }
  }
  /* Touch pointers get the full 44px on every control in the bar. */
  @media (pointer: coarse) {
    .brand,
    .link,
    .float {
      min-height: 44px;
    }
  }
  @media (max-width: 720px) {
    .float {
      padding: 8px 14px;
      font-size: 13px;
    }
  }
  /* Measured at 375px: the centred pill ran 69→306 while the flanking buttons
     sat at 16→75 and 274→359, so both overlapped it. The pill is what has to
     give — the floats are pinned to the screen edges. CV stays; what gives is
     the full name (first name only from here down) and the 40px gap, which
     together take the pill back under the ~200px of daylight between flanks. */
  @media (max-width: 560px) {
    .nav-links {
      margin-inline-start: 12px;
    }
    .b-full {
      display: none;
    }
    .b-short {
      display: inline;
    }
    nav {
      padding-inline: 14px 8px;
    }
    .brand {
      font-size: 12px;
    }
    .link {
      font-size: 12px;
      padding: 6px 8px;
    }
    /* Pulled in from clamp(16px, 4vw, 48px): the extra 4px a side is what turns
       a 2px collision with the pill into real daylight. Physical left/right on
       purpose, matching the base rules — these two keep their screen corners in
       both reading directions. */
    .lang {
      left: 12px;
    }
    .cta {
      right: 12px;
    }
  }
  @media (max-width: 520px) {
    nav {
      padding-block: 8px;
      padding-inline: 12px 6px;
    }
    .nav-links {
      margin-inline-start: 8px;
    }
    .float {
      padding: 7px 12px;
      font-size: 13px;
    }
  }
  /* Below ~400px (old SE, Fold cover screen) the flanks close to ~62px and ~90px,
     leaving roughly 150px of centre. Brand and CV both still fit at these sizes,
     but only with the gap gone and the pill squeezed to its padding minimum. */
  @media (max-width: 400px) {
    .brand {
      font-size: 11px;
    }
    .nav-links {
      margin-inline-start: 6px;
    }
    .link {
      padding: 6px 6px;
    }
  }
</style>
