---
// Shared by / and /ar/ — every child reads its own locale off the URL, so the
// two route files are one line each and can never drift out of sync.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Preloader from './Preloader.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import WorkGrid from './WorkGrid.astro';
import About from './About.astro';
import Experience from './Experience.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { getLangFromUrl, t } from '../i18n/ui';

const copy = t(getLangFromUrl(Astro.url)).meta;

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
// Only projects with real artwork reach the grid — a card with neither a cover
// nor a recording is an empty placeholder tile, and a row of those reads as
// unfinished rather than as work. A screen recording counts as artwork: the card
// plays it in the tile. The entries still exist, so their detail pages keep building.
const shown = projects.filter((p) => p.data.cover || p.data.video);
---

<Base title={copy.home}>
  <Preloader />
  <Nav />
  <main id="main">
    <Hero />
    <WorkGrid projects={shown} />
    <About />
    <Experience />
    <Contact />
  </main>
  {/* Outside <main>: the glow is position: fixed, and a transformed ancestor
      (page transitions, parallax) would capture it. */}
  <Footer />
</Base>
