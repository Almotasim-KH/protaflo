---
import { getLangFromUrl, t } from '../i18n/ui';

const copy = t(getLangFromUrl(Astro.url)).hero;
---

<section class="hero" data-hero data-ground="dark" aria-labelledby="hero-title">
  {
    /* Kicker. Rides its own parallax layer at the title's speed so the two travel
      together — reveal.ts tweens y on [data-reveal] itself, so one element can
      never carry both a reveal and a data-speed. Same reason .p-layer exists.
      Lands after the headline wipe has started and before the term row, so it
      reads as the title's label rather than as a line of its own. */
  }
  <div class="k-layer" data-speed="1.18" data-parallax-start="top top">
    <p class="eyebrow" data-reveal="loader" data-reveal-delay="0.5">{copy.eyebrow}</p>
  </div>

  {
    /* A. Bar-wipe headline — each line is its own accent+white sweep (hero-intro.ts
      adds .play on loader complete; the animation itself is pure CSS below). */
  }
  {
    /* Title leads (speed > 1): safe to parallax directly — its intro is pure CSS,
      nothing else writes transform on it. */
  }
  <h1 id="hero-title" class="title" data-hero-title data-speed="1.18" data-parallax-start="top top">
    <span class="line"><span class="lt">{copy.line1}</span></span>
    <span class="line"
      ><span class="lt"
        >{copy.line2Pre}<span class="muted">{copy.line2Muted}</span>{copy.line2Post}</span
      ></span
    >
  </h1>

  {
    /* Standfirst — one claim, with the year set as its own span so scramble.ts
      churns only the four digits and the sentence around them stays readable
      the whole time. */
  }
  <p class="subline" data-reveal="loader" data-reveal-delay="0.85">
    <span class="term">{copy.claim}</span>
    <span class="term scramble" data-scramble={copy.claimYear}>{copy.claimYear}</span>
  </p>

  {
    /* Parallax rides an OUTER wrapper: reveal.ts tweens `y` on [data-reveal] itself,
      and two systems on one element's y would fight. Portrait lags (speed < 1). */
  }
  <div class="p-layer" data-speed="0.8" data-parallax-start="top top">
    <div class="portrait-wrap" data-reveal="loader" data-reveal-delay="1.0">
      {/* D. Mind scratches — hero-intro.ts cycles work-derived marks over the head. */}
      <svg class="scribble" viewBox="0 0 200 70" fill="none" aria-hidden="true" data-scribble></svg>
      {
        /* Portrait — the photo at its own 537×797 ratio, cut at the knee. It still
        carries its own hallway background, so it is graded and edge-masked
        (see .portrait) to sit inside the hero instead of on top of it, with a
        glow pool behind and a floor shadow under. */
      }
      <img class="portrait" src="/me-2.webp" alt={copy.portraitAlt} width="1074" height="1594" />
    </div>
  </div>

  {
    /* C. Background marks — sourced from /public/deco/*.svg, tinted through a CSS
      mask so each one carries its own gradient and glow. Ten marks, each shape
      used exactly once: the four abstract ones and the six chapter glyphs
      (strength, nourishment, code, travel, learning, stillness), so the hero
      ground carries the same vocabulary as the chapters below it.

      Scattered, but composed — the irregularity is the work, not the absence of
      it. Four rules hold it together:

        1. No two marks share an edge, a step, or a size. Every horizontal
           inset and every vertical gap is a different number, so the eye never
           finds the grid and starts reading rhythm instead of ground.
        2. Size carries depth. A few large marks sit near and bright, the small
           ones fall back and dim, and each big one is answered by a small one
           near it — an anchor and its echo, never two anchors side by side.
        3. The two sides are deliberately unequal: different counts at each
           height, different sizes, no mirroring. Symmetry is what makes a
           scatter look placed by a script.
        4. Nothing crosses the two lines of type, the standfirst, or the
           portrait. The field runs in the margins and closes under the fold.

      `.d-extra` is the half that drops on a phone, chosen so the six that
      survive still read as a scatter rather than a thinned rail. */
  }
  <div class="deco" aria-hidden="true">
    {/* leading side — anchor high, echo low */}
    <span data-shape class="d s-sprout c-lime" style="left:4%;top:12%;width:68px;opacity:.55"
    ></span>
    <span data-shape class="d d-extra s-code c-cyan" style="left:9%;top:33%;width:34px;opacity:.45"
    ></span>
    <span data-shape class="d s-strength c-accent" style="left:6%;top:52%;width:52px;opacity:.5"
    ></span>
    <span
      data-shape
      class="d d-extra s-sparkle c-white"
      style="left:17%;top:63%;width:22px;opacity:.6"></span>
    <span data-shape class="d s-learning c-lime" style="left:3%;top:78%;width:44px;opacity:.4"
    ></span>
    <span
      data-shape
      class="d d-extra s-dots c-accent"
      style="left:12%;top:88%;width:26px;opacity:.45"></span>

    {/* trailing side — anchor lower, and one fewer mark up top */}
    <span
      data-shape
      class="d d-extra s-nourishment c-cyan"
      style="right:7%;top:9%;width:40px;opacity:.5"></span>
    <span
      data-shape
      class="d d-extra s-squiggle c-accent"
      style="right:4%;top:23%;width:72px;opacity:.5"></span>
    <span
      data-shape
      class="d d-extra s-travel c-lime"
      style="right:15%;top:44%;width:30px;opacity:.45"></span>
    <span data-shape class="d s-stillness c-white" style="right:6%;top:58%;width:56px;opacity:.5"
    ></span>
    <span
      data-shape
      class="d d-extra s-code c-accent"
      style="right:19%;top:71%;width:24px;opacity:.35"></span>
    <span data-shape class="d s-sparkle c-white" style="right:5%;top:86%;width:34px;opacity:.55"
    ></span>
  </div>

  {
    /* E. Scroll tile-dissolve — filled + driven by tileDissolve.js.
      data-scroll-start begins earlier than it used to (was 50%): the dissolve
      now spans a longer stretch of scroll, so it advances less per notch. That,
      the raised scrub, and the scroll weight tileDissolve.js switches on for the
      length of the trigger are the three things that give it drag. */
  }
  <div
    class="pxt"
    data-pixelated-scroll-transition
    data-columns="16"
    data-columns-tablet="12"
    data-columns-mobile="10"
    data-rows="8"
    data-rows-tablet="11"
    data-rows-mobile="14"
    data-scroll-start="35% top"
    aria-hidden="true"
  >
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 200px clamp(24px, 7vw, 120px) 90px;
    position: relative;
    background: var(--color-hero);
    overflow: hidden;
    width: 100%;
  }

  /* ---- A. bar-wipe headline ---- */
  .title {
    margin: 0 0 28px;
    font-size: clamp(27px, 5vw, 71px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-align: center;
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .line {
    position: relative;
    display: block;
    --d: 0s;
  }
  .line:nth-of-type(2) {
    --d: 0.28s;
  }
  .lt {
    position: relative;
    z-index: 1;
    display: inline-block;
  }
  .title .muted {
    color: #8c8c88;
  }
  /* accent bar leads, white bar chases; both clipped away before .play.
     Bars sit on .lt (inline-block = text width) so each sweep covers only the
     text, never the full line box. */
  .lt::before,
  .lt::after {
    content: '';
    position: absolute;
    inset: -4px 0;
    z-index: 2;
    clip-path: inset(0 100% 0 0);
    pointer-events: none;
  }
  .lt::before {
    background: var(--color-accent);
  }
  .lt::after {
    background: #fff;
  }
  .title.play .line .lt::before {
    animation: barSweep 1.25s cubic-bezier(0.16, 1, 0.3, 1) var(--d) both;
  }
  .title.play .line .lt::after {
    animation: barSweep 1.25s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--d) + 0.12s) both;
  }
  .title.play .lt {
    animation: htextIn 1.25s linear var(--d) both;
  }
  @keyframes barSweep {
    0% {
      clip-path: inset(0 100% 0 0);
    }
    45% {
      clip-path: inset(0 0 0 0);
    }
    100% {
      clip-path: inset(0 0 0 100%);
    }
  }
  @keyframes htextIn {
    0%,
    22% {
      opacity: 0;
    }
    23%,
    100% {
      opacity: 1;
    }
  }

  /* parallax-only wrapper for the kicker — transform, no layout of its own */
  .k-layer {
    position: relative;
    z-index: 1;
    width: 100%;
    will-change: transform;
  }
  /* Tracked and uppercased so it reads as a label and not as a short sentence
     competing with the title. global.css undoes both for Arabic, which has no
     uppercase and joins its letters — tracking there pulls the glyphs apart. */
  .eyebrow {
    margin: 0 0 20px;
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8f8f88;
  }

  /* Term row. Flex rather than inline text so the dots can be real gaps the
     row wraps at, instead of characters that can end a line on their own. */
  .subline {
    margin: 0 0 18px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0 0.4em;
    font-size: 18px;
    color: #a8a8a2;
    line-height: 1.6;
    position: relative;
    z-index: 1;
  }
  .term {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
  }
  .scramble {
    display: inline-block;
    color: var(--color-accent);
    font-weight: 600;
    white-space: pre;
  }
  /* parallax-only wrapper — carries the scrub transform, no layout of its own */
  .p-layer {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    justify-content: center;
    will-change: transform;
  }
  .portrait-wrap {
    position: relative;
    z-index: 1;
    /* This crop starts just above the head, so unlike the earlier full-length
       one there is no empty band inside the frame for the mark to sit in — the
       top margin is the band, and .scribble hangs into it from above. */
    margin: 72px auto 0;
    width: min(400px, 80vw);
    display: flex;
    justify-content: center;
    isolation: isolate;
  }
  /* Light pool behind the figure — gives the cutout something to stand in, so
     the masked edges read as falloff rather than as a crop. */
  .portrait-wrap::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 4%;
    width: 150%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    background: radial-gradient(
      circle at 50% 42%,
      rgba(232, 245, 68, 0.1) 0%,
      rgba(232, 245, 68, 0.04) 34%,
      rgba(28, 28, 28, 0) 66%
    );
    pointer-events: none;
    z-index: -1;
  }
  /* Contact shadow so the figure sits ON the section instead of floating. */
  .portrait-wrap::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2%;
    width: 78%;
    height: 9%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 70%);
    filter: blur(6px);
    pointer-events: none;
    z-index: -1;
  }
  /* Sits above the frame, not inside it: in the 537×797 crop the ghutra starts
     ~5% down, which is less headroom than the mark is tall. Pulled up by its
     own height (50% of the width, at a 200×70 board, is 17.5% of the width —
     and the wrap is 1.48× as tall as it is wide, so ~12% of the wrap) so its
     bottom edge lands on the frame's top edge, clear of the hairline. */
  .scribble {
    position: absolute;
    top: -13%;
    left: 50%;
    transform: translateX(-50%);
    width: 50%;
    pointer-events: none;
    z-index: 3;
    filter: drop-shadow(0 0 8px rgba(0, 0, 0, 0.55));
  }
  /* Two-part blend:
     1. grade — desaturate + darken so the photo's own colour temperature stops
        fighting the monochrome-plus-accent hero.
     2. mask — feather all four edges (hardest at the bottom, where the frame is
        widest) so the rectangle never announces itself. Two gradients composited
        with intersect: one vertical, one horizontal. */
  .portrait {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(0.62) saturate(1.08) contrast(1.06) brightness(0.88);
    -webkit-mask-image:
      linear-gradient(to bottom, transparent 0%, #000 4%, #000 82%, transparent 100%),
      linear-gradient(to right, transparent 0%, #000 6%, #000 94%, transparent 100%);
    mask-image:
      linear-gradient(to bottom, transparent 0%, #000 4%, #000 82%, transparent 100%),
      linear-gradient(to right, transparent 0%, #000 6%, #000 94%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  .deco {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  /* Each shape is a mask of a file in /public/deco, so its colour stays CSS.
     The mask lives on ::before, never on .d itself: CSS applies filters BEFORE
     masking, so a glow on a masked element would be clipped to the shape. */
  .deco .d {
    position: absolute;
    display: block;
    filter: drop-shadow(0 0 6px var(--glow)) drop-shadow(0 0 16px var(--glow));
  }
  .deco .d::before {
    content: '';
    display: block;
    width: 100%;
    height: 100%;
    background-image: linear-gradient(
      125deg,
      var(--c1) 0%,
      var(--c2) 38%,
      #fff 50%,
      var(--c1) 62%,
      var(--c2) 100%
    );
    background-size: 300% 300%;
    background-position: 0% 50%;
    -webkit-mask-image: var(--src);
    mask-image: var(--src);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
    animation: decoShine 6s linear infinite var(--shine-delay, 0s);
  }
  /* the sweep is the "shine" — the white stop travelling across the gradient */
  @keyframes decoShine {
    to {
      background-position: 300% 50%;
    }
  }

  /* palettes: c1 → c2 gradient, glow is the halo colour */
  .deco .c-accent {
    --c1: var(--color-accent);
    --c2: #b4ff3d;
    --glow: rgba(232, 245, 68, 0.55);
  }
  .deco .c-lime {
    --c1: #9dff5c;
    --c2: #37e0a8;
    --glow: rgba(85, 240, 160, 0.5);
  }
  .deco .c-cyan {
    --c1: #5ad7ff;
    --c2: #7b8cff;
    --glow: rgba(90, 200, 255, 0.5);
  }
  .deco .c-pink {
    --c1: #ff7ae0;
    --c2: #ff9b6a;
    --glow: rgba(255, 122, 224, 0.45);
  }
  .deco .c-orange {
    --c1: #ffb347;
    --c2: #ff6f61;
    --glow: rgba(255, 150, 70, 0.45);
  }
  .deco .c-violet {
    --c1: #b98bff;
    --c2: #6ad3ff;
    --glow: rgba(170, 130, 255, 0.45);
  }
  .deco .c-white {
    --c1: #fff;
    --c2: #d8e8ff;
    --glow: rgba(255, 255, 255, 0.5);
  }

  /* stagger the sweeps so they never shine in lockstep */
  .deco .d:nth-of-type(3n) {
    --shine-delay: -2s;
  }
  .deco .d:nth-of-type(3n + 1) {
    --shine-delay: -4s;
  }

  .deco .s-sparkle {
    aspect-ratio: 1;
    --src: url('/deco/sparkle.svg');
  }
  .deco .s-sprout {
    aspect-ratio: 140 / 195;
    --src: url('/deco/vectorized.svg');
  }
  .deco .s-squiggle {
    aspect-ratio: 72 / 40;
    --src: url('/deco/squiggle.svg');
  }
  .deco .s-burst {
    aspect-ratio: 1;
    --src: url('/deco/burst.svg');
  }
  .deco .s-dots {
    aspect-ratio: 1;
    --src: url('/deco/dots.svg');
  }
  /* Chapter glyphs — all authored on a 120×120 board, so all square. Each file
     carries a blurred copy of its own artwork under the solid one; masked on
     alpha that reads as a soft halo around the gradient, over the CSS glow. */
  .deco .s-strength {
    aspect-ratio: 1;
    --src: url('/deco/01-strength.svg');
  }
  .deco .s-nourishment {
    aspect-ratio: 1;
    --src: url('/deco/02-nourishment.svg');
  }
  .deco .s-code {
    aspect-ratio: 1;
    --src: url('/deco/03-code.svg');
  }
  .deco .s-travel {
    aspect-ratio: 1;
    --src: url('/deco/04-travel.svg');
  }
  .deco .s-learning {
    aspect-ratio: 1;
    --src: url('/deco/06-learning.svg');
  }
  .deco .s-stillness {
    aspect-ratio: 1;
    --src: url('/deco/07-stillness.svg');
  }

  /* Narrow screens: the margins that carry the scatter on desktop are gone, so
     half the marks drop. The six that stay were picked to keep the uneven
     reading — three a side at unrelated heights — and they clamp small enough
     to sit beside the headline rather than under it. */
  @media (max-width: 760px) {
    /* At 50% of a 312px wrap the mark is 156px wide, which on a phone reads as
       an icon parked above the photo rather than as a scratch over the head. */
    .scribble {
      width: 34%;
      top: -9%;
    }
    .deco .d-extra {
      display: none;
    }
    /* width only: opacity is animated inline by hero-intro.ts, and !important
       here would beat GSAP and kill the pop-in. */
    .deco .d {
      width: 34px !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deco .d::before {
      animation: none;
      background-position: 50% 50%;
    }
  }
  .pxt {
    position: absolute;
    inset: -2px;
    pointer-events: none;
    z-index: 6;
  }
</style>
